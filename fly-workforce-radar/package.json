{
  "name": "fly-workforce-radar",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": "24.15.0", "npm": "11.12.1" },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run --exclude **/*.live.test.ts",
    "schema:validate": "vitest run src/test/schema",
    "evidence:validate": "vitest run src/test/evidence",
    "source:validate": "vitest run src/test/source",
    "ingestion:validate": "vitest run src/test/ingestion",
    "claims:validate": "vitest run src/test/claims",
    "company:validate": "vitest run src/test/company",
    "manpower:validate": "vitest run src/test/manpower-acceptance",
    "contact:validate": "vitest run src/test/contact",
    "opportunity:validate": "vitest run src/test/opportunity",
    "verification:validate": "vitest run src/test/verification",
    "eligibility:validate": "vitest run src/test/eligibility",
    "scoring:validate": "vitest run src/test/scoring",
    "commercial-action:validate": "vitest run src/test/commercial-action",
    "integration:validate": "vitest run src/test/integration",
    "production-source:validate": "vitest run src/test/production-source",
    "production-adapters:validate": "vitest run src/test/production-source/production-adapters.test.ts",
    "production-adapters:live": "vitest run src/server/adapters/production/production-adapters.live.test.ts --maxWorkers=1 --no-file-parallelism",
    "multi-source:validate": "vitest run src/test/production-source/multi-source-expansion.test.ts",
    "multi-source:live": "vitest run src/server/adapters/production/multi-source.live.test.ts --maxWorkers=1 --no-file-parallelism",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.5",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
