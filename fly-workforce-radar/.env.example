# Public application origin. Do not include a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 3I-B3A: Supabase Auth for internal operator sign-in only (admin-invite
# provisioning, no public signup). Local development uses the isolated
# Fly Workforce Radar stack configured in supabase/config.toml. Never copy
# credentials from Fly Bid Radar or a remote/production Supabase project.
# Only the URL and publishable key are ever read by browser code; there is
# no server secret/service-role key here because normal operator login does
# not require one. Leaving these unset makes sign-in fail safely (see
# createServerSupabaseClient/createSupabaseBrowserClient).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-workforce-local-publishable-key

# Server-side PostgreSQL connection. Local development must remain on the
# Workforce-only port below. Supply credentials in .env.local, never here.
DATABASE_URL=postgresql://postgres:replace-with-local-password@127.0.0.1:55422/postgres

# Optional local bootstrap account coordinates. Keep the actual password in
# ignored .env.local only; the seed deliberately contains no reusable password.
LOCAL_DEMO_OPERATOR_EMAIL=local-workforce-operator@example.invalid
LOCAL_DEMO_OPERATOR_PASSWORD=replace-with-local-only-password
